# IXOPE U-Boot Config Fragment — Fast Boot + 3s Splash Logo for RK3566
# Target: Show logo at 0.5s, hold for 3s, then boot kernel

# ─── Boot Timing ──────────────────────────────────────────────────────
# Zero boot delay — no interactive prompt, auto-boot immediately
CONFIG_BOOTDELAY=0
CONFIG_AUTOBOOT=y

# Boot command: load splash → display 3s → boot kernel directly
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="if load mmc 1:1 0x02000000 /boot/splash.bmp; then bmp display 0x02000000; sleep 3; fi; load mmc 1:1 0x02080000 /boot/Image; load mmc 1:1 0x0a100000 /boot/rk3566-radxa-zero-3w-ap6212.dtb; setenv bootargs root=/dev/mmcblk1p1 rootfstype=ext4 rootwait rw quiet loglevel=0 vt.global_cursor_default=0 consoleblank=0; booti 0x02080000 - 0x0a100000"

# Enable sysboot/extlinux support (alternative boot method)
CONFIG_CMD_PXE=y
CONFIG_CMD_SYSBOOT=y

# ─── Video / Splash ───────────────────────────────────────────────────
# Enable video subsystem for DSI panel splash
CONFIG_VIDEO=y
CONFIG_DM_VIDEO=y
CONFIG_VIDEO_ROCKCHIP=y
CONFIG_DISPLAY=y

# BMP splash support
CONFIG_SPLASH_SCREEN=y
CONFIG_SPLASH_SCREEN_ALIGN=y
CONFIG_CMD_BMP=y
CONFIG_BMP_16BPP=y
CONFIG_BMP_24BPP=y
CONFIG_BMP_32BPP=y
CONFIG_VIDEO_BMP_RLE8=y
CONFIG_VIDEO_BMP_GZIP=y

# ─── Silent Console ──────────────────────────────────────────────────
# No serial output from U-Boot (clean boot)
CONFIG_SILENT_CONSOLE=y
CONFIG_SYS_DEVICE_NULLDEV=y
CONFIG_SILENT_CONSOLE_UPDATE_ON_SET=y
CONFIG_SYS_CONSOLE_INFO_QUIET=y
CONFIG_DISPLAY_BOARDINFO=n
CONFIG_DISPLAY_BOARDINFO_LATE=n
CONFIG_LOGLEVEL=0
CONFIG_EXTRA_ENV_SETTINGS="silent=1\0"

# ─── Disable Unnecessary Subsystems (saves boot time) ────────────────
CONFIG_CMD_USB=n
CONFIG_USB_STORAGE=n
CONFIG_USB_KEYBOARD=n
CONFIG_CMD_DHCP=n
CONFIG_CMD_NET=n
CONFIG_CMD_NFS=n
CONFIG_CMD_TFTPBOOT=n
CONFIG_EFI_LOADER=n
CONFIG_SCSI=n
CONFIG_CMD_SCSI=n
CONFIG_NVME=n
CONFIG_CMD_NVME=n

# ─── Boot Blobs ──────────────────────────────────────────────────────
# Use external TPL (Rockchip DDR binary from download-blobs.sh)
CONFIG_ROCKCHIP_EXTERNAL_TPL=y
