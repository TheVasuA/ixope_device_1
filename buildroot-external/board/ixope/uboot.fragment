# IXOPE U-Boot Config Fragment — Maximum Fast Boot for RK3566
# Target: kernel loaded in < 2s from U-Boot start

# Zero boot delay — no countdown, no interactive prompt
CONFIG_BOOTDELAY=0
CONFIG_AUTOBOOT=y
CONFIG_AUTOBOOT_KEYED=y
CONFIG_AUTOBOOT_PROMPT=""

# Boot directly from MMC via extlinux — no scanning
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="sysboot mmc 1:1 any 0x02000000 /boot/extlinux/extlinux.conf"

# Disable ALL unnecessary subsystem probing
CONFIG_CMD_USB=n
CONFIG_USB_STORAGE=n
CONFIG_USB_KEYBOARD=n
CONFIG_CMD_PXE=n
CONFIG_CMD_DHCP=n
CONFIG_CMD_NET=n
CONFIG_CMD_NFS=n
CONFIG_CMD_TFTPBOOT=n
CONFIG_EFI_LOADER=n
CONFIG_SCSI=n
CONFIG_CMD_SCSI=n
CONFIG_NVME=n
CONFIG_CMD_NVME=n

# Quiet — suppress all non-critical output
CONFIG_LOGLEVEL=1
CONFIG_SYS_CONSOLE_INFO_QUIET=y
CONFIG_DISPLAY_BOARDINFO=n
CONFIG_DISPLAY_BOARDINFO_LATE=n

# Skip FIT hash verification (saves ~300ms)
# CONFIG_FIT_SIGNATURE is not set

# Disable video in U-Boot (kernel handles display)
# This saves ~500ms of display init
CONFIG_VIDEO=n
CONFIG_DM_VIDEO=n
CONFIG_DISPLAY=n
CONFIG_VIDEO_ROCKCHIP=n

# Rockchip
CONFIG_ROCKCHIP_EXTERNAL_TPL=y
