# IXOPE U-Boot Config Fragment — Fastest Possible Boot for RK3566
# Target: Skip all splash/video, boot kernel immediately

# ─── Boot Timing ──────────────────────────────────────────────────────
# Zero boot delay — no interactive prompt, auto-boot immediately
CONFIG_BOOTDELAY=0
CONFIG_AUTOBOOT=y

# Boot command: load kernel + DTB directly, no splash, no video init
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="load mmc 1:1 0x02080000 /boot/Image; load mmc 1:1 0x0a100000 /boot/rk3566-radxa-zero-3w-ap6212.dtb; setenv bootargs root=/dev/mmcblk1p1 rootfstype=ext4 rootwait rw quiet loglevel=0 vt.global_cursor_default=0 consoleblank=0 udev.event_timeout=2 random.trust_cpu=on loop.max_loop=4; booti 0x02080000 - 0x0a100000"

# Enable sysboot/extlinux support (alternative boot method)
CONFIG_CMD_PXE=y
CONFIG_CMD_SYSBOOT=y

# ─── Fast Boot: Disable hash verification in SPL (saves ~2-3s) ───────
CONFIG_FIT_SIGNATURE=n
CONFIG_SPL_FIT_SIGNATURE=n
CONFIG_SPL_SHA256=n

# ─── NO Video in U-Boot (saves 2-3s HDMI/DRM probe time) ─────────────
# Splash is handled by kernel framebuffer console (S01splash script)
CONFIG_VIDEO=n
CONFIG_DM_VIDEO=n
CONFIG_VIDEO_ROCKCHIP=n
CONFIG_DISPLAY=n
CONFIG_DRM_ROCKCHIP=n
CONFIG_PHY_ROCKCHIP_INNO_HDMI=n
CONFIG_ROCKCHIP_DW_HDMI=n
CONFIG_I2C_EDID=n
CONFIG_VIDEO_LOGO=n
CONFIG_SPLASH_SCREEN=n
CONFIG_CMD_BMP=n

# ─── Silent Console ──────────────────────────────────────────────────
# No serial output from U-Boot (clean boot)
CONFIG_SILENT_CONSOLE=y
CONFIG_SYS_DEVICE_NULLDEV=y
CONFIG_SILENT_CONSOLE_UPDATE_ON_SET=y
CONFIG_SYS_CONSOLE_INFO_QUIET=y
CONFIG_DISPLAY_BOARDINFO=n
CONFIG_DISPLAY_BOARDINFO_LATE=n
CONFIG_LOGLEVEL=0
CONFIG_EXTRA_ENV_SETTINGS="silent=1\0"

# ─── Disable Unnecessary Subsystems (saves boot time) ────────────────
CONFIG_CMD_USB=n
CONFIG_USB_STORAGE=n
CONFIG_USB_KEYBOARD=n
CONFIG_CMD_DHCP=n
CONFIG_CMD_NET=n
CONFIG_CMD_NFS=n
CONFIG_CMD_TFTPBOOT=n
CONFIG_EFI_LOADER=n
CONFIG_SCSI=n
CONFIG_CMD_SCSI=n
CONFIG_NVME=n
CONFIG_CMD_NVME=n

# ─── Boot Blobs ──────────────────────────────────────────────────────
# Use external TPL (Rockchip DDR binary from download-blobs.sh)
CONFIG_ROCKCHIP_EXTERNAL_TPL=y
