# IXOPE U-Boot Config Fragment — Silent Fast Boot for RK3566
# Target: boot kernel in < 1.5s from U-Boot start, ZERO console output

# Zero boot delay — instant boot, no interactive prompt
CONFIG_BOOTDELAY=0
CONFIG_AUTOBOOT=y

# Boot directly from MMC via extlinux
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="sysboot mmc 1:1 any 0x02000000 /boot/extlinux/extlinux.conf"

# SILENT CONSOLE — no serial output from U-Boot
CONFIG_SILENT_CONSOLE=y
CONFIG_SYS_DEVICE_NULLDEV=y
CONFIG_SILENT_CONSOLE_UPDATE_ON_SET=y

# Suppress board info display
CONFIG_SYS_CONSOLE_INFO_QUIET=y
CONFIG_DISPLAY_BOARDINFO=n
CONFIG_DISPLAY_BOARDINFO_LATE=n
CONFIG_LOGLEVEL=0

# Set silent=1 in default environment
CONFIG_EXTRA_ENV_SETTINGS="silent=1\0"

# Disable ALL unnecessary subsystem probing (saves 1-2s)
CONFIG_CMD_USB=n
CONFIG_USB_STORAGE=n
CONFIG_USB_KEYBOARD=n
CONFIG_CMD_PXE=n
CONFIG_CMD_DHCP=n
CONFIG_CMD_NET=n
CONFIG_CMD_NFS=n
CONFIG_CMD_TFTPBOOT=n
CONFIG_EFI_LOADER=n
CONFIG_SCSI=n
CONFIG_CMD_SCSI=n
CONFIG_NVME=n
CONFIG_CMD_NVME=n

# Disable video subsystem in U-Boot (kernel handles DSI panel)
CONFIG_VIDEO=n
CONFIG_DM_VIDEO=n
CONFIG_DISPLAY=n
CONFIG_VIDEO_ROCKCHIP=n

# Use external TPL (Rockchip DDR binary)
CONFIG_ROCKCHIP_EXTERNAL_TPL=y
