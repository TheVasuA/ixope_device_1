# IXOPE U-Boot Config Fragment — Fast Boot for Radxa Zero 3W (RK3566)
# Target: boot to kernel in under 2 seconds from U-Boot

# Zero boot delay — skip interactive prompt
CONFIG_BOOTDELAY=0
CONFIG_AUTOBOOT=y

# Boot directly from MMC1 (SD/eMMC) via extlinux.conf
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="sysboot mmc 1:1 any 0x02000000 /boot/extlinux/extlinux.conf"

# Disable USB boot scanning (saves ~1-2 seconds)
CONFIG_CMD_USB=n
CONFIG_USB_STORAGE=n
CONFIG_USB_KEYBOARD=n
CONFIG_USB_HOST=n

# Disable network boot
CONFIG_CMD_PXE=n
CONFIG_CMD_DHCP=n
CONFIG_CMD_NET=n
CONFIG_CMD_NFS=n
CONFIG_CMD_TFTPBOOT=n

# Disable EFI (saves binary size + boot time)
CONFIG_EFI_LOADER=n

# Disable SCSI/NVMe (not present on Zero 3W)
CONFIG_SCSI=n
CONFIG_CMD_SCSI=n
CONFIG_NVME=n
CONFIG_CMD_NVME=n

# Quiet boot output
CONFIG_LOGLEVEL=4
CONFIG_SYS_CONSOLE_INFO_QUIET=y

# Disable binman TPL requirement (use rkdeveloptool for flashing instead)
CONFIG_ROCKCHIP_EXTERNAL_TPL=n
