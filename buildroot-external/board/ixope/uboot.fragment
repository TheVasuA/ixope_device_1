# IXOPE U-Boot Config Fragment — Fast Boot for Radxa Zero 3W
# Target: boot to kernel in under 3 seconds from U-Boot

# Zero boot delay
CONFIG_BOOTDELAY=0
CONFIG_AUTOBOOT=y

# Disable USB boot scanning (saves 3-5 seconds)
CONFIG_CMD_USB=n
CONFIG_USB_STORAGE=n
CONFIG_USB_KEYBOARD=n
CONFIG_USB_HOST=n

# Disable network boot (saves 2-3 seconds)
CONFIG_CMD_PXE=n
CONFIG_CMD_DHCP=n
CONFIG_CMD_NET=n
CONFIG_CMD_NFS=n
CONFIG_CMD_TFTPBOOT=n

# Only boot from MMC extlinux — no other sources
CONFIG_BOOT_RETRY=n

# Disable EFI which adds scan time
CONFIG_EFI_LOADER=n

# Skip SCSI
CONFIG_SCSI=n
CONFIG_CMD_SCSI=n

# Quiet boot
CONFIG_LOGLEVEL=4
CONFIG_SYS_CONSOLE_INFO_QUIET=y
