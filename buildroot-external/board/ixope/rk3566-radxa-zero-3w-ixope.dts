// IXOPE Medical Device — Radxa Zero 3W with ST7701S 480x480 DSI panel
// Based on mainline rk3566-radxa-zero-3w.dts + DSI panel configuration

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/soc/rockchip,vop2.h>

// Include the base Radxa Zero 3W device tree
#include "rk3566-radxa-zero-3w.dts"

/ {
	model = "IXOPE Medical Device (Radxa Zero 3W)";

	backlight_dsi: backlight-dsi {
		compatible = "gpio-backlight";
		status = "okay";
	};

	panel_vdd: panel-vdd-regulator {
		compatible = "regulator-fixed";
		regulator-name = "panel_vdd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};
};

&dsi0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			dsi0_in_vp1: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&vp1_out_dsi0>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_out_panel: endpoint {
				remote-endpoint = <&mipi_in_panel>;
			};
		};
	};

	panel@0 {
		compatible = "sitronix,st7701";
		reg = <0>;
		backlight = <&backlight_dsi>;
		reset-gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
		VCC-supply = <&panel_vdd>;
		IOVCC-supply = <&panel_vdd>;

		port {
			mipi_in_panel: endpoint {
				remote-endpoint = <&mipi_out_panel>;
			};
		};
	};
};

&mipi_dphy0 {
	status = "okay";
};

&vp1 {
	vp1_out_dsi0: endpoint@ROCKCHIP_VOP2_EP_MIPI0 {
		reg = <ROCKCHIP_VOP2_EP_MIPI0>;
		remote-endpoint = <&dsi0_in_vp1>;
	};
};
