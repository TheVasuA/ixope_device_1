# IXOPE Kernel Config Fragment — Official Radxa BSP 5.10 kernel
# Applied on top of rockchip_linux_defconfig

# ═══════════════════════════════════════════════════════════════
# DRM/Display — MIPI DSI panel (ST7701S 480x480) + HDMI
# ═══════════════════════════════════════════════════════════════
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_PANEL_SITRONIX_ST7701=y
CONFIG_DRM_BRIDGE=y
CONFIG_DRM_DW_MIPI_DSI=y
CONFIG_DRM_DW_HDMI=y
CONFIG_ROCKCHIP_VOP2=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_PHY_ROCKCHIP_INNO_HDMI=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y

# ═══════════════════════════════════════════════════════════════
# GPU (Panfrost for Mali G52)
# ═══════════════════════════════════════════════════════════════
CONFIG_DRM_PANFROST=y

# ═══════════════════════════════════════════════════════════════
# V4L2 / USB Camera (built-in, not modules)
# ═══════════════════════════════════════════════════════════════
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_V4L2=y
CONFIG_USB_VIDEO_CLASS=y
CONFIG_VIDEOBUF2_VMALLOC=y

# ═══════════════════════════════════════════════════════════════
# USB (for camera + peripherals — all built-in)
# ═══════════════════════════════════════════════════════════════
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GENERIC=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_EXTCON=y

# ═══════════════════════════════════════════════════════════════
# I2C (LED controller + touch panel)
# ═══════════════════════════════════════════════════════════════
CONFIG_I2C=y
CONFIG_I2C_RK3X=y
CONFIG_I2C_CHARDEV=y

# ═══════════════════════════════════════════════════════════════
# Touchscreen (Goodix GT911 — common on round displays)
# ═══════════════════════════════════════════════════════════════
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=y

# ═══════════════════════════════════════════════════════════════
# UART/Serial
# ═══════════════════════════════════════════════════════════════
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_8250_CONSOLE=y

# ═══════════════════════════════════════════════════════════════
# WiFi (BCM43430/AP6212 — built-in, NOT module)
# Use Rockchip's out-of-tree bcmdhd driver (in-tree for BSP kernel)
# ═══════════════════════════════════════════════════════════════
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_BRCMUTIL=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_WL_ROCKCHIP=y

# Disable -Werror for entire kernel (Rockchip BSP has GCC 12+ warnings)
CONFIG_WERROR=n

# ═══════════════════════════════════════════════════════════════
# PWM (backlight control)
# ═══════════════════════════════════════════════════════════════
CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP=y

# ═══════════════════════════════════════════════════════════════
# RTC + Power Management
# ═══════════════════════════════════════════════════════════════
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_RK808=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_RK808=y
CONFIG_REGULATOR_FAN53555=y
CONFIG_MFD_RK8XX_I2C=y

# ═══════════════════════════════════════════════════════════════
# GPIO
# ═══════════════════════════════════════════════════════════════
CONFIG_GPIOLIB=y
CONFIG_GPIO_ROCKCHIP=y

# ═══════════════════════════════════════════════════════════════
# Device Tree Overlays
# ═══════════════════════════════════════════════════════════════
CONFIG_OF_OVERLAY=y
