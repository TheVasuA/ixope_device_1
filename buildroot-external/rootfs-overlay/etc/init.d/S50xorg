#!/bin/sh
# Start Xorg — no delays, check if already running
case "$1" in
  start)
    # Don't start if already running
    [ -e /tmp/.X11-unix/X0 ] && exit 0
    rm -f /tmp/.X0-lock
    Xorg :0 -nolisten tcp -noreset vt1 &
    # Wait for X socket (fast poll)
    n=0
    while [ ! -e /tmp/.X11-unix/X0 ] && [ $n -lt 30 ]; do
      usleep 100000
      n=$((n + 1))
    done
    ;;
  stop)
    killall Xorg 2>/dev/null
    rm -f /tmp/.X0-lock /tmp/.X11-unix/X0
    ;;
  restart)
    $0 stop
    $0 start
    ;;
esac
