#!/bin/sh
# IXOPE — Show splash on framebuffer at boot (before X starts)
case "$1" in
  start)
    # Fill framebuffer with black + centered text fallback
    if [ -c /dev/fb0 ]; then
        # Clear framebuffer to black (480x480 ARGB)
        dd if=/dev/zero of=/dev/fb0 bs=921600 count=1 2>/dev/null
    fi
    # Console fallback — hide cursor, show text
    echo -e "\033[2J\033[H\033[?25l" > /dev/tty1 2>/dev/null
    echo -e "\n\n\n\n\n\n\n\n\n          IXOPE\n\n        Loading..." > /dev/tty1 2>/dev/null
    ;;
esac
