#!/bin/sh
# IXOPE — Show "IXOPE" centered on framebuffer immediately at boot
# This is the FIRST thing the user sees after kernel starts (~3s from power on)
case "$1" in
  start)
    # Hide cursor and clear screen on console
    printf '\033[2J\033[H\033[?25l' > /dev/tty1 2>/dev/null

    # Center "IXOPE" on a 480x480 display (assuming ~30 rows, ~60 cols)
    printf '\033[15;25H\033[1;37mIXOPE\033[0m' > /dev/tty1 2>/dev/null
    ;;
esac
