#!/bin/sh
case "$1" in
  start)
    mkdir -p /var/ixope-data/logs /var/ixope-data/captured_images /var/ixope-data/recorded_videos
    export DISPLAY=:0
    export IXOPE_BASE_PATH=/var/ixope-data
    export HOME=/root

    # Show splash screen while app loads
    python3 /opt/ixope/splash.py &
    SPLASH_PID=$!

    # Wait for X to be ready
    sleep 2

    # Launch the application (kills splash when ready)
    cd /opt/ixope
    kill $SPLASH_PID 2>/dev/null
    python3 app.py >> /var/ixope-data/logs/boot.log 2>&1 &
    echo $! > /var/run/ixope.pid
    ;;
  stop)
    [ -f /var/run/ixope.pid ] && kill $(cat /var/run/ixope.pid) 2>/dev/null
    rm -f /var/run/ixope.pid
    ;;
  restart)
    $0 stop; sleep 1; $0 start
    ;;
esac
