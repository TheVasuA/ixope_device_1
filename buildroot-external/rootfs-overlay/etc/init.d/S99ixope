#!/bin/sh
# IXOPE Medical Device — Application startup script
case "$1" in
  start)
    # Create data directories (preserves existing content)
    mkdir -p /var/ixope-data/logs
    mkdir -p /var/ixope-data/captured_images/opth
    mkdir -p /var/ixope-data/captured_images/oto
    mkdir -p /var/ixope-data/captured_images/derm
    mkdir -p /var/ixope-data/captured_images/micro
    mkdir -p /var/ixope-data/recorded_videos/opth
    mkdir -p /var/ixope-data/recorded_videos/oto
    mkdir -p /var/ixope-data/recorded_videos/derm
    mkdir -p /var/ixope-data/recorded_videos/micro

    # Environment
    export DISPLAY=:0
    export IXOPE_BASE_PATH=/var/ixope-data
    export HOME=/root

    # Wait for X to be ready (max 5s)
    for i in 1 2 3 4 5; do
        xdpyinfo >/dev/null 2>&1 && break
        sleep 1
    done

    # Launch the application
    cd /opt/ixope
    python3 app.py >> /var/ixope-data/logs/boot.log 2>&1 &
    echo $! > /var/run/ixope.pid
    ;;
  stop)
    [ -f /var/run/ixope.pid ] && kill $(cat /var/run/ixope.pid) 2>/dev/null
    rm -f /var/run/ixope.pid
    ;;
  restart)
    $0 stop
    sleep 1
    $0 start
    ;;
esac
