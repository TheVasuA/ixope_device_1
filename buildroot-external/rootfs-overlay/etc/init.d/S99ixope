#!/bin/sh
# IXOPE app is now started from S50xorg (immediately after X is ready)
# This script exists only for stop/restart compatibility
case "$1" in
  start)
    # App already started by S50xorg
    ;;
  stop)
    [ -f /var/run/ixope.pid ] && kill $(cat /var/run/ixope.pid) 2>/dev/null
    rm -f /var/run/ixope.pid
    ;;
  restart)
    $0 stop
    # Re-launch
    export DISPLAY=:0
    export IXOPE_BASE_PATH=/var/ixope-data
    export HOME=/root
    cd /opt/ixope
    python3 app.py >> /var/ixope-data/logs/boot.log 2>&1 &
    echo $! > /var/run/ixope.pid
    ;;
esac
