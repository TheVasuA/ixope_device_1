#!/bin/sh
# IXOPE — Start dbus + NetworkManager for WiFi (AIC8800)
# No blocking waits — NetworkManager handles wlan0 detection itself
case "$1" in
  start)
    mkdir -p /var/run/dbus
    [ -x /usr/bin/dbus-daemon ] && dbus-daemon --system --fork 2>/dev/null
    [ -x /usr/sbin/NetworkManager ] && NetworkManager --daemon 2>/dev/null
    ;;
  stop)
    killall NetworkManager 2>/dev/null
    killall wpa_supplicant 2>/dev/null
    killall dbus-daemon 2>/dev/null
    ;;
  restart)
    $0 stop
    $0 start
    ;;
esac
