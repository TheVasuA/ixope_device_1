# IXOPE Medical Device — Buildroot defconfig for Radxa Zero 3W (RK3566)
# Official Radxa BSP kernel 5.10 (linux-5.10-gen-rkr8-buildroot)
# Target: boot to app in ~5 seconds on eMMC, ~7s on SD card.

# ═══════════════════════════════════════════════════════════════════════
# ARCHITECTURE
# ═══════════════════════════════════════════════════════════════════════
BR2_aarch64=y
BR2_cortex_a55=y

# ═══════════════════════════════════════════════════════════════════════
# TOOLCHAIN
# ═══════════════════════════════════════════════════════════════════════
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_5_10=y
BR2_PACKAGE_HOST_PYTHON3=y

# ═══════════════════════════════════════════════════════════════════════
# SYSTEM
# ═══════════════════════════════════════════════════════════════════════
BR2_TARGET_GENERIC_HOSTNAME="ixope"
BR2_TARGET_GENERIC_ISSUE="IXOPE Medical Device"
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_IXOPE_PATH)/rootfs-overlay"

# ═══════════════════════════════════════════════════════════════════════
# KERNEL — Official Radxa BSP 5.10
# ═══════════════════════════════════════════════════════════════════════
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/radxa/kernel.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="linux-5.10-gen-rkr8-buildroot"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="rockchip_linux"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_IXOPE_PATH)/board/ixope/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3566-radxa-zero-3w-ap6212"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_CUSTOM_MAKEOPTS="KCFLAGS=-Wno-error=address"

# ═══════════════════════════════════════════════════════════════════════
# BOOTLOADER — Custom U-Boot built from source (fast boot, 0 delay)
# Requires rkbin blobs (DDR init + BL31). Download with:
#   bash buildroot-external/board/ixope/download-blobs.sh
# ═══════════════════════════════════════════════════════════════════════
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2024.01"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="radxa-cm3-io-rk3566"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_IXOPE_PATH)/board/ixope/uboot.fragment"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_PYELFTOOLS=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot-rockchip.bin"
BR2_TARGET_UBOOT_CUSTOM_MAKEOPTS="BL31=$(BR2_EXTERNAL_IXOPE_PATH)/board/ixope/bl31.elf ROCKCHIP_TPL=$(BR2_EXTERNAL_IXOPE_PATH)/board/ixope/ddr.bin"

# ═══════════════════════════════════════════════════════════════════════
# FILESYSTEM
# ═══════════════════════════════════════════════════════════════════════
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"

# ═══════════════════════════════════════════════════════════════════════
# POST-BUILD / POST-IMAGE SCRIPTS
# ═══════════════════════════════════════════════════════════════════════
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_IXOPE_PATH)/board/ixope/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_IXOPE_PATH)/board/ixope/create-sdcard-image.sh"

# ═══════════════════════════════════════════════════════════════════════
# PYTHON 3 + PACKAGES
# ═══════════════════════════════════════════════════════════════════════
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON_PILLOW=y
BR2_PACKAGE_PYTHON_PILLOW_JPEG=y
BR2_PACKAGE_PYTHON_NUMPY=y
BR2_PACKAGE_PYTHON_FLASK=y
BR2_PACKAGE_PYTHON_REQUESTS=y

# ═══════════════════════════════════════════════════════════════════════
# IMAGE LIBRARIES (required by Pillow and OpenCV for JPEG/PNG)
# ═══════════════════════════════════════════════════════════════════════
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_ZLIB=y

# ═══════════════════════════════════════════════════════════════════════
# OPENCV (with Python bindings for cv2)
# ═══════════════════════════════════════════════════════════════════════
BR2_PACKAGE_OPENCV4=y
BR2_PACKAGE_OPENCV4_LIB_IMGPROC=y
BR2_PACKAGE_OPENCV4_LIB_VIDEOIO=y
BR2_PACKAGE_OPENCV4_LIB_IMGCODECS=y
BR2_PACKAGE_OPENCV4_LIB_PYTHON=y
BR2_PACKAGE_OPENCV4_WITH_FFMPEG=y
BR2_PACKAGE_OPENCV4_WITH_V4L=y
BR2_PACKAGE_OPENCV4_WITH_JPEG=y
BR2_PACKAGE_OPENCV4_WITH_PNG=y

# ═══════════════════════════════════════════════════════════════════════
# DISPLAY (minimal X11 for Tkinter)
# ═══════════════════════════════════════════════════════════════════════
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XSERVER_XORG_SERVER=y
BR2_PACKAGE_XLIB_LIBX11=y
BR2_PACKAGE_XLIB_LIBXEXT=y
BR2_PACKAGE_XLIB_LIBXFT=y
BR2_PACKAGE_XLIB_LIBXRENDER=y
BR2_PACKAGE_XLIB_LIBXSS=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_MODESETTING=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_EVDEV=y
BR2_PACKAGE_PYTHON3_TKINTER=y
BR2_PACKAGE_TCL=y
BR2_PACKAGE_TK=y
BR2_PACKAGE_XCB_UTIL=y
BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_XLIB_LIBXT=y
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_LIBERATION=y

# ═══════════════════════════════════════════════════════════════════════
# NETWORKING (WiFi + nmcli)
# Board has AIC8800 WiFi (NOT Broadcom/AP6212 despite board name)
# NetworkManager requires udev — enable eudev (BusyBox mdev is not enough)
# ═══════════════════════════════════════════════════════════════════════
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_PACKAGE_AIC8800_WIFI=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_AP=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_NETWORK_MANAGER=y
BR2_PACKAGE_NETWORK_MANAGER_CLI=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_TOOLS=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_LIBNL=y
BR2_PACKAGE_READLINE=y
BR2_PACKAGE_LIBGLIB2=y

# ═══════════════════════════════════════════════════════════════════════
# HARDWARE (serial, GPIO)
# ═══════════════════════════════════════════════════════════════════════
BR2_PACKAGE_DTC=y
BR2_PACKAGE_DTC_PROGRAMS=y

# ═══════════════════════════════════════════════════════════════════════
# UTILITIES
# ═══════════════════════════════════════════════════════════════════════
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_UNCLUTTER=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_NTP=y
BR2_PACKAGE_NTP_NTPDATE=y

# ═══════════════════════════════════════════════════════════════════════
# IXOPE APP
# ═══════════════════════════════════════════════════════════════════════
BR2_PACKAGE_IXOPE_APP=y
