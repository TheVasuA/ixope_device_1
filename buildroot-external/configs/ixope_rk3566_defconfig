# IXOPE Medical Device — Buildroot defconfig for Radxa Zero 3W (RK3566)
# Minimal image: boots to the app in ~5 seconds on eMMC.

# ═══════════════════════════════════════════════════════════════════════
# ARCHITECTURE
# ═══════════════════════════════════════════════════════════════════════
BR2_aarch64=y
BR2_cortex_a55=y

# ═══════════════════════════════════════════════════════════════════════
# TOOLCHAIN
# ═══════════════════════════════════════════════════════════════════════
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_PACKAGE_HOST_PYTHON3=y

# ═══════════════════════════════════════════════════════════════════════
# SYSTEM
# ═══════════════════════════════════════════════════════════════════════
BR2_TARGET_GENERIC_HOSTNAME="ixope"
BR2_TARGET_GENERIC_ISSUE="IXOPE Medical Device"
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_IXOPE_PATH)/rootfs-overlay"

# ═══════════════════════════════════════════════════════════════════════
# KERNEL — Mainline 6.12 with DSI panel support
# ═══════════════════════════════════════════════════════════════════════
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_IXOPE_PATH)/board/ixope/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3566-radxa-zero-3w"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# ═══════════════════════════════════════════════════════════════════════
# BOOTLOADER (U-Boot)
# ═══════════════════════════════════════════════════════════════════════
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2024.01"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="evb-rk3568"
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot-rockchip.bin"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_IXOPE_PATH)/board/ixope/uboot.fragment"

# ═══════════════════════════════════════════════════════════════════════
# FILESYSTEM (ext4 for dev, squashfs for production — faster mount)
# ═══════════════════════════════════════════════════════════════════════
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
# Production: uncomment squashfs for read-only, ~1s faster mount
# BR2_TARGET_ROOTFS_SQUASHFS=y
# BR2_TARGET_ROOTFS_SQUASHFS_LZ4=y

# ═══════════════════════════════════════════════════════════════════════
# POST-BUILD / POST-IMAGE SCRIPTS
# ═══════════════════════════════════════════════════════════════════════
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_IXOPE_PATH)/board/ixope/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_IXOPE_PATH)/board/ixope/create-sdcard-image.sh"

# ═══════════════════════════════════════════════════════════════════════
# PYTHON 3 + PACKAGES (matches requirements.txt)
# ═══════════════════════════════════════════════════════════════════════
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON_PILLOW=y
BR2_PACKAGE_PYTHON_NUMPY=y
BR2_PACKAGE_PYTHON_FLASK=y
BR2_PACKAGE_PYTHON_REQUESTS=y
BR2_PACKAGE_PYTHON_SMBUS2=y

# ═══════════════════════════════════════════════════════════════════════
# OPENCV (headless, minimal — camera capture + video codec only)
# ═══════════════════════════════════════════════════════════════════════
BR2_PACKAGE_OPENCV4=y
BR2_PACKAGE_OPENCV4_LIB_IMGPROC=y
BR2_PACKAGE_OPENCV4_LIB_VIDEOIO=y
BR2_PACKAGE_OPENCV4_LIB_IMGCODECS=y
BR2_PACKAGE_OPENCV4_WITH_FFMPEG=y
BR2_PACKAGE_OPENCV4_WITH_V4L=y

# ═══════════════════════════════════════════════════════════════════════
# DISPLAY (minimal X11 — just enough for Tkinter)
# ═══════════════════════════════════════════════════════════════════════
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XSERVER_XORG_SERVER=y
BR2_PACKAGE_XLIB_LIBX11=y
BR2_PACKAGE_XLIB_LIBXEXT=y
BR2_PACKAGE_XLIB_LIBXFT=y
BR2_PACKAGE_XLIB_LIBXRENDER=y
BR2_PACKAGE_XLIB_LIBXSS=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_MODESETTING=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_EVDEV=y
BR2_PACKAGE_PYTHON3_TKINTER=y
BR2_PACKAGE_TCL=y
BR2_PACKAGE_TK=y
BR2_PACKAGE_XCB_UTIL=y
BR2_PACKAGE_FONTCONFIG=y

# ═══════════════════════════════════════════════════════════════════════
# NETWORKING (WiFi + nmcli)
# ═══════════════════════════════════════════════════════════════════════
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_NETWORK_MANAGER=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_TOOLS=y
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XXX=y

# ═══════════════════════════════════════════════════════════════════════
# HARDWARE (I2C, serial, GPIO)
# ═══════════════════════════════════════════════════════════════════════
BR2_PACKAGE_I2C_TOOLS=y

# ═══════════════════════════════════════════════════════════════════════
# UTILITIES (minimal — remove htop/dropbear for production to save boot time)
# ═══════════════════════════════════════════════════════════════════════
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_UNCLUTTER=y
# BR2_PACKAGE_HTOP=y         # disable for production (saves ~0.2s)
# BR2_PACKAGE_DROPBEAR=y     # disable for production (saves ~0.5s)
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_DROPBEAR=y

# ═══════════════════════════════════════════════════════════════════════
# YOUR APP
# ═══════════════════════════════════════════════════════════════════════
BR2_PACKAGE_IXOPE_APP=y
